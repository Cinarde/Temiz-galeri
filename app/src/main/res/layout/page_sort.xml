<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageSort" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:id="@+id/sortContent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="20dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="10dp"
                android:src="@drawable/app_logo" android:importantForAccessibility="no" />
            <TextView style="@style/Eyebrow" android:layout_width="0dp" android:layout_weight="1" android:text="@string/brand_label" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/offline_label"
                android:textSize="11sp" android:textColor="@color/accent" android:background="@drawable/bg_soft"
                android:paddingHorizontal="12dp" android:paddingVertical="6dp" />
        </LinearLayout>
        <TextView style="@style/PageTitle" android:text="@string/sort_title" />
        <TextView style="@style/BodyText" android:layout_marginTop="4dp" android:text="@string/sort_subtitle" />
        <TextView android:id="@+id/status" style="@style/BodyText" android:layout_marginTop="16dp"
            android:textSize="12sp" android:accessibilityLiveRegion="polite" />
        <FrameLayout android:id="@+id/photoArea" android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="12dp">
            <com.example.galerinitemizle.SwipeDeckView android:id="@+id/deck" android:layout_width="match_parent" android:layout_height="match_parent" />
            <LinearLayout android:id="@+id/emptyPanel" android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_soft" android:gravity="center" android:orientation="vertical" android:padding="24dp">
                <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_gallery" app:tint="@color/accent" android:importantForAccessibility="no" />
                <TextView android:id="@+id/emptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:gravity="center" android:text="@string/start_title" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" />
                <TextView android:id="@+id/emptyMessage" style="@style/BodyText" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/need_access" />
                <com.google.android.material.button.MaterialButton android:id="@+id/startButton" style="@style/PrimaryAction"
                    android:layout_marginTop="20dp" android:text="@string/grant_access" app:icon="@drawable/ic_arrow" app:iconGravity="textEnd" />
            </LinearLayout>
            <ProgressBar android:id="@+id/progress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:id="@+id/swipeActions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/discardButton" style="@style/PrimaryAction"
                android:layout_width="0dp" android:layout_weight="1" android:text="@string/discard_short"
                android:textColor="@color/danger" app:backgroundTint="@color/danger_soft" app:icon="@drawable/ic_close" app:iconTint="@color/danger" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/undoButton" style="@style/PrimaryAction"
                android:layout_width="56dp" android:layout_marginHorizontal="10dp" android:padding="0dp"
                android:contentDescription="@string/undo" app:backgroundTint="@color/surface_card" app:icon="@drawable/ic_undo" app:iconTint="@color/undo_tint" app:iconGravity="textStart" app:iconPadding="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/keepButton" style="@style/PrimaryAction"
                android:layout_width="0dp" android:layout_weight="1" android:text="@string/keep_short" app:icon="@drawable/ic_check" app:iconGravity="textStart" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/reviewButton" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_queue" app:icon="@drawable/ic_arrow" app:iconGravity="textEnd" />
    </LinearLayout>
</ScrollView>
